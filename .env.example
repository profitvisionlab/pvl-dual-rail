# Copy to .env for local smoke with live FinOps (optional).
# Never commit real keys.

# FinOps rail — OpenRouter（預設 chain 的備援：Together 掛掉才用到）
OPENROUTER_API_KEY=sk-or-v1-...

# Optional Tri-Tier overrides
# OPENROUTER_TIER1_MODELS=
# OPENROUTER_TIER2_MODELS=
# OPENROUTER_TIER3_MODELS=
# OPENROUTER_QUANTIZATIONS=bf16,fp16   # leave unset for Claude/GPT

# Enterprise rail — use mock for offline verification
ENTERPRISE_ADAPTER=mock
# VERTEX_PROJECT_ID=your-gcp-project
# VERTEX_LOCATION=us-central1
# VERTEX_ACCESS_TOKEN=ya29....

# ── NVIDIA NIM ── ⛔ 2026-09-07 除役
# FinOps 軌改為 Together 主力、OpenRouter 備援。NIM adapter 與當時的選型實測
# （8 篇 zh→ja goldset、模型 EOL 的教訓）保留在 git 歷史，設定不再需要。
# 除役理由見 README「Provider chain」。

# DUAL_RAIL_FORCE_TIER：把 finops 軌釘在指定層（1/2/3），蓋過 task 對應與
# contextTokens 啟發式。🔴 **預設就該是沒有設定** —— 它原本的理由是 NIM 免費期，
# 那個理由已隨 NIM 除役消失；在 Together 上釘 tier3 等於每個輕量任務付旗艦價。
# DUAL_RAIL_FORCE_TIER=

# ── Together（FinOps 軌主力，2026-09-07 起）───────────────────────────────────────
TOGETHER_API_KEY=

# 每層的模型清單，逗號分隔，依序當 fallback 鏈（前一個失敗才換下一個）。
# 本套件「不內建預設」—— 供應商目錄變動快，寫死的清單過期時會變成
# 「看似能跑但實際 400」，而錯誤訊息不會告訴你原因。
# 挑選方法論見 src/adapters/together.mjs 檔頭。未設定會明確報錯。
TOGETHER_TIER1_MODELS=
TOGETHER_TIER2_MODELS=
TOGETHER_TIER3_MODELS=

# 推理模型會把預算燒在 message.reasoning 上，給太小會回
# content:"" + finish_reason:"length"。建議 ≥8000。
TOGETHER_MAX_ATTEMPTS=3
TOGETHER_TIMEOUT_MS=45000

# ── FinOps provider chain（0.3.0）──────────────────────────────────────────────
# 逗號分隔，依序嘗試；沒設金鑰的供應商自動跳過（記在 attempts，不算降級）。
# 可用：together, deepinfra, lightning, openrouter。寫錯名字直接報 DUAL_RAIL_BAD_CHAIN。
# 未設定＝together,openrouter（與 0.2.0 相同）。
# DUAL_RAIL_FINOPS_CHAIN=together,deepinfra,lightning,openrouter

# ── DeepInfra（同款模型備援／長前綴、翻譯、結構化抽取首選）──────────────────────
# DEEPINFRA_API_KEY=
# DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
# DEEPINFRA_TIER1_MODELS=
# DEEPINFRA_TIER2_MODELS=
# DEEPINFRA_TIER3_MODELS=
# DEEPINFRA_MAX_ATTEMPTS=3
# DEEPINFRA_TIMEOUT_MS=45000

# ── Lightning AI（前沿模型 Anthropic／OpenAI／Google 一把金鑰；最後備援）────────
# base URL 取自 2026-09-07 模型頁範例，尚未以真實金鑰實打驗證。
# LIGHTNING_API_KEY=
# LIGHTNING_BASE_URL=https://lightning.ai/api/v1
# LIGHTNING_TIER1_MODELS=
# LIGHTNING_TIER2_MODELS=
# LIGHTNING_TIER3_MODELS=
# LIGHTNING_MAX_ATTEMPTS=3
# LIGHTNING_TIMEOUT_MS=45000
