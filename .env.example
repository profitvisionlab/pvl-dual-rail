# Copy to .env for local smoke with live FinOps (optional).
# Never commit real keys.

# FinOps rail — OpenRouter（第三備援，NIM 與 Together 都掛掉才用到）
OPENROUTER_API_KEY=sk-or-v1-...

# Optional Tri-Tier overrides
# OPENROUTER_TIER1_MODELS=
# OPENROUTER_TIER2_MODELS=
# OPENROUTER_TIER3_MODELS=
# OPENROUTER_QUANTIZATIONS=bf16,fp16   # leave unset for Claude/GPT

# Enterprise rail — use mock for offline verification
ENTERPRISE_ADAPTER=mock
# VERTEX_PROJECT_ID=your-gcp-project
# VERTEX_LOCATION=us-central1
# VERTEX_ACCESS_TOKEN=ya29....

# ── NVIDIA NIM（FinOps 軌主力供應商，2026-08-25 ～ 2027-02-25 免費／高額度期）──
# 拿 key：https://build.nvidia.com（選模型 → Get API Key）
NVIDIA_NIM_API_KEY=

# 每層的模型清單，逗號分隔，依序當 fallback 鏈（前一個失敗才換下一個）。
# 本套件「不內建預設」—— NIM 目錄變動快，寫死的清單過期時會變成
# 「看似能跑但實際 404」。上線前用 build.nvidia.com 的 model card 逐一確認 slug。
# 挑選方法論見 src/adapters/nim.mjs 檔頭。未設定會明確報錯。
#
# 參考：PVL 自己 2026-08-25/26 的實測（8 篇 zh→ja goldset）挑出來的是
#   tier1  nvidia/nvidia-nemotron-nano-9b-v2        precision 1.00 / recall 1.00（需 max_tokens≥2000）
#   tier2  nvidia/llama-3.3-nemotron-super-49b-v1.5 殘留中位 0.36 / 相似度 0.42
#   tier3  nvidia/nemotron-3-ultra-550b-a55b        相似度 0.49 / 術語 83%
# 🔴 但上面 tier1／tier2 那兩顆在 2026-08-26T09:00:00Z **已 EOL**（打過去回 410 Gone），
#    也就是量完隔天就死。這條的教訓比選人結果本身更重要：
#    NIM 目錄變動以「天」為單位（一天內 101 顆 → 83 顆），而且
#    **列在 GET /v1/models 不等於叫得到**（nemotron-nano-3-30b-a3b、
#    llama-3.1-nemotron-70b-instruct 都在目錄裡，實打 404）。
#    → 選完到部署之間要重打一次；把「模型不見了」與「模型變差了」在監控上分開。
# **這是 PVL 自家任務的結論，不要當通則。** 你的任務形狀不同，結果可能相反：
# 同一顆 nemotron-3-nano-30b 在術語擷取是最划算的（19 tok），在翻譯卻最差
# （殘留中文是對手的 90 倍）。照 src/adapters/nim.mjs 檔頭的方法論自己測。
NIM_TIER1_MODELS=
NIM_TIER2_MODELS=
NIM_TIER3_MODELS=

# DUAL_RAIL_FORCE_TIER：把 finops 軌釘在指定層（1/2/3），蓋過 task 對應與
# contextTokens 啟發式。PVL 用它在 NIM 免費期讓 tier3 吃到真實流量。
# 不設就照原本的 tier 解析走。enterprise 軌不受影響。
# DUAL_RAIL_FORCE_TIER=3

NIM_MAX_ATTEMPTS=3
# 逾時要跟著任務的輸出量走：數十 token 的分類任務 45 秒夠用，
# 上千 token 的長文生成在免費層可能要好幾分鐘。PVL 實測 bench 用到 300 秒。
NIM_TIMEOUT_MS=45000

# ── Together（FinOps 軌第二備援）───────────────────────────────────────
TOGETHER_API_KEY=

# 每層的模型清單，逗號分隔，依序當 fallback 鏈（前一個失敗才換下一個）。
# 本套件「不內建預設」—— 供應商目錄變動快，寫死的清單過期時會變成
# 「看似能跑但實際 400」，而錯誤訊息不會告訴你原因。
# 挑選方法論見 src/adapters/together.mjs 檔頭。未設定會明確報錯。
TOGETHER_TIER1_MODELS=
TOGETHER_TIER2_MODELS=
TOGETHER_TIER3_MODELS=

# 推理模型會把預算燒在 message.reasoning 上，給太小會回
# content:"" + finish_reason:"length"。建議 ≥8000。
TOGETHER_MAX_ATTEMPTS=3
TOGETHER_TIMEOUT_MS=45000
